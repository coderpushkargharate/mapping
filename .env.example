# ---------------------------------------------------------------------------
# Mappingg Next.js — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB connection string. SERVER-ONLY — must never be exposed to the browser.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster.
MONGODB_DB=mappingg

# Secret used to sign session JWTs (HTTP-only cookie). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL, used for canonical links / sitemap / Open Graph.
NEXT_PUBLIC_SITE_URL=https://mappingg.com

# Google Maps JS API key (Places autocomplete for search). This is a PUBLIC,
# browser-side key and MUST be locked down by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Only variables prefixed with NEXT_PUBLIC_ are exposed to client-side code.
# MONGODB_URI and AUTH_SECRET are server-only and must never get that prefix.
# ---------------------------------------------------------------------------
